generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  email             String?
  phone             String?
  address           String?
  logo              String?
  description       String?
  primaryColor      String?
  secondaryColor    String?
  websiteEnabled    Boolean           @default(true)
  admissionsEnabled Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  academicYears     AcademicYear[]
  accountingEntries AccountingEntry[]
  attendance        Attendance[]
  contactMessages   ContactMessage[]
  fees              Fee[]
  galleryItems      GalleryItem[]
  news              NewsItem[]
  parents           Parent[]
  reportCardInfos   ReportCardInfo[]
  classes           SchoolClass[]
  socialLinks       SocialLink[]
  staffTasks        StaffTask[]
  students          Student[]
  studentNotes      StudentNote[]
  subjects          Subject[]
  teachers          Teacher[]
  timetableEntries  TimetableEntry[]
  users             User[]
  websitePages      WebsitePage[]
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole      @default(STUDENT)
  schoolId     String
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  parentId     String?       @unique
  studentId    String?       @unique
  teacherId    String?       @unique
  staffTasks   StaffTask[]
  studentNotes StudentNote[]
  parent       Parent?       @relation(fields: [parentId], references: [id])
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student?      @relation(fields: [studentId], references: [id])
  teacher      Teacher?      @relation(fields: [teacherId], references: [id])

  @@index([schoolId])
  @@index([role])
}

model Student {
  id              String           @id @default(cuid())
  studentNumber   String           @unique
  firstName       String
  lastName        String
  gender          String
  dateOfBirth     DateTime?
  phone           String?
  email           String?
  address         String?
  guardianName    String?
  guardianPhone   String?
  classId         String?
  schoolId        String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  photoUrl        String?
  attendance      Attendance[]
  fees            Fee[]
  wards           ParentStudent[]
  payments        Payment[]
  reportCardInfos ReportCardInfo[]
  results         Result[]
  class           SchoolClass?     @relation(fields: [classId], references: [id])
  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  notes           StudentNote[]
  submissions     Submission[]
  user            User?

  @@index([schoolId])
  @@index([classId])
}

model Teacher {
  id               String           @id @default(cuid())
  employeeNumber   String           @unique
  firstName        String
  lastName         String
  gender           String
  phone            String
  email            String?
  address          String?
  qualification    String?
  specialization   String?
  schoolId         String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  position         String?
  photoUrl         String?
  assignments      Assignment[]
  ClassSubject     ClassSubject[]
  results          Result[]
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableEntries TimetableEntry[]
  user             User?

  @@index([schoolId])
}

model Parent {
  id        String          @id @default(cuid())
  firstName String
  lastName  String
  phone     String?
  email     String?
  address   String?
  schoolId  String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  school    School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  children  ParentStudent[]
  user      User?

  @@index([schoolId])
}

model ParentStudent {
  id           String   @id @default(cuid())
  parentId     String
  studentId    String
  relationship String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  parent       Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
}

model SchoolClass {
  id               String           @id @default(cuid())
  name             String
  description      String?
  schoolId         String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  assignments      Assignment[]
  attendance       Attendance[]
  subjects         ClassSubject[]
  fees             Fee[]
  results          Result[]
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students         Student[]
  timetableEntries TimetableEntry[]

  @@unique([schoolId, name])
}

model Subject {
  id               String           @id @default(cuid())
  name             String
  code             String
  description      String?
  schoolId         String
  assignments      Assignment[]
  classes          ClassSubject[]
  results          Result[]
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  timetableEntries TimetableEntry[]

  @@unique([schoolId, code])
}

model ClassSubject {
  id        String      @id @default(cuid())
  classId   String
  subjectId String
  teacherId String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher?    @relation(fields: [teacherId], references: [id])

  @@unique([classId, subjectId])
}

model Assignment {
  id          String       @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  classId     String
  subjectId   String
  teacherId   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  class       SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  submissions Submission[]
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  studentId    String
  answer       String
  status       String     @default("SUBMITTED")
  grade        Float?
  feedback     String?
  submittedAt  DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
}

model Result {
  id              String        @id @default(cuid())
  studentId       String
  classId         String
  subjectId       String
  teacherId       String?
  assessmentScore Float?
  examScore       Float?
  totalScore      Float?
  grade           String?
  remark          String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  academicYearId  String?
  termId          String?
  academicYear    AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class           SchoolClass   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject         Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher         Teacher?      @relation(fields: [teacherId], references: [id])
  term            Term?         @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, academicYearId, termId])
  @@index([studentId])
  @@index([classId])
  @@index([subjectId])
  @@index([teacherId])
  @@index([academicYearId])
  @@index([termId])
}

model GalleryItem {
  id          String   @id @default(cuid())
  schoolId    String
  title       String?
  description String?
  imageUrl    String
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sortOrder   Int      @default(0)
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model SocialLink {
  id        String  @id @default(cuid())
  schoolId  String
  platform  String
  url       String
  label     String?
  enabled   Boolean @default(true)
  sortOrder Int     @default(0)
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, platform])
  @@index([schoolId])
}

model Fee {
  id           String       @id @default(cuid())
  title        String
  description  String?
  amount       Float
  academicYear String
  term         String
  studentId    String
  schoolId     String
  classId      String?
  dueDate      DateTime?
  status       String       @default("UNPAID")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  class        SchoolClass? @relation(fields: [classId], references: [id])
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([studentId])
  @@index([schoolId])
  @@index([classId])
  @@index([academicYear])
  @@index([term])
}

model Payment {
  id        String   @id @default(cuid())
  feeId     String
  studentId String
  amount    Float
  reference String?
  method    String   @default("CASH")
  status    String   @default("COMPLETED")
  paidAt    DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  fee       Fee      @relation(fields: [feeId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([feeId])
  @@index([studentId])
}

model Attendance {
  id        String      @id @default(cuid())
  studentId String
  classId   String
  schoolId  String
  date      DateTime
  status    String      @default("PRESENT")
  remarks   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  school    School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([schoolId])
  @@index([classId])
  @@index([studentId])
  @@index([date])
}

model WebsitePage {
  id        String   @id @default(cuid())
  schoolId  String
  slug      String
  title     String
  subtitle  String?
  heroImage String?
  content   Json
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, slug])
  @@index([schoolId])
}

model NewsItem {
  id          String   @id @default(cuid())
  schoolId    String
  title       String
  excerpt     String?
  content     String
  imageUrl    String?
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([published])
  @@index([publishedAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  email     String?
  phone     String?
  subject   String?
  message   String
  type      String   @default("ENQUIRY")
  status    String   @default("NEW")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model AcademicYear {
  id               String           @id @default(cuid())
  name             String
  startDate        DateTime
  endDate          DateTime
  isCurrent        Boolean          @default(false)
  schoolId         String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  school           School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  results          Result[]
  terms            Term[]
  timetableEntries TimetableEntry[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([isCurrent])
}

model Term {
  id               String           @id @default(cuid())
  name             String
  order            Int
  startDate        DateTime
  endDate          DateTime
  isCurrent        Boolean          @default(false)
  academicYearId   String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  results          Result[]
  academicYear     AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  timetableEntries TimetableEntry[]

  @@unique([academicYearId, name])
  @@unique([academicYearId, order])
  @@index([academicYearId])
  @@index([isCurrent])
}

model TimetableEntry {
  id             String       @id @default(cuid())
  schoolId       String
  academicYearId String
  termId         String
  classId        String
  subjectId      String
  teacherId      String?
  dayOfWeek      Int
  startTime      String
  endTime        String
  room           String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  class          SchoolClass  @relation(fields: [classId], references: [id], onDelete: Cascade)
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher        Teacher?     @relation(fields: [teacherId], references: [id])
  term           Term         @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([academicYearId])
  @@index([termId])
  @@index([classId])
  @@index([subjectId])
  @@index([teacherId])
}

model ReportCardInfo {
  id                    String    @id @default(cuid())
  schoolId              String
  studentId             String
  academicYearId        String?
  termId                String?
  photoUrl              String?
  vacationDate          DateTime?
  reopeningDate         DateTime?
  promotionStatus       String?
  conduct               String?
  attitude              String?
  interest              String?
  classTeacherRemark    String?
  headteacherRemark     String?
  classTeacherName      String?
  headteacherName       String?
  classTeacherSignature String?
  headteacherSignature  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  school                School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student               Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId, termId])
  @@index([schoolId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([termId])
}

model StaffTask {
  id          String    @id @default(cuid())
  schoolId    String
  userId      String
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([userId])
  @@index([completed])
  @@index([dueDate])
}

model StudentNote {
  id        String   @id @default(cuid())
  schoolId  String
  studentId String
  authorId  String
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([studentId])
  @@index([authorId])
  @@index([createdAt])
}

model AccountingEntry {
  id            String   @id @default(cuid())
  schoolId      String
  type          String
  category      String
  description   String
  amount        Float
  reference     String?
  paymentMethod String?
  entryDate     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([schoolId, type])
  @@index([schoolId, entryDate])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
  PARENT
}
